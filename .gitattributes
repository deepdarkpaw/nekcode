# Default to LF for text files across the repo
* text=auto eol=lf

# Windows scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts should keep LF
*.sh text eol=lf

# Archived patch artifacts preserve whitespace exactly
packages/agent/docs/**/*.diff -whitespace

# Source release archives omit test suites; normal Git checkouts retain them.
test export-ignore
tests export-ignore
__tests__ export-ignore
*.test.* export-ignore
*.spec.* export-ignore
*-test.* export-ignore
test.ts export-ignore
mini-test.sh export-ignore
/test.sh export-ignore

# Common binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
